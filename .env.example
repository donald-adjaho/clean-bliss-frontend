# ---- WORDPRESS BACKEND ----
# Base URL of your Wordpress backend
# URL de base de ton backend Wordpress
NEXT_PUBLIC_WP_URL=https://votre-site.com

# GraphQL endpoint (WPGraphQL)
# Endpoint GraphQL (WPGraphQL)
NEXT_PUBLIC_WP_GRAPHQL_URL=https://votre-site.com/graphql

# Faust.js secret key (WP -> Settings -> Faust.js)
# Clé secrète Faust.js (WP -> Réglages -> Faust.js)
FAUST_SECRET_KEY=votre-cle-secrete-ici

# ---- DEV ONLY ----
# Disable SSL vérification - DEVELOPMENT ONLY
# Désactive la vérification SSL - DÉVELOPPEMENT UNIQUEMENT
# ⚠️ Remove this line in production / Retirer cette ligne en production
NODE_TLS_REJECT_UNAUTHORIZED=0
